<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Keys the generated Info.plist can't express. Local networking lets the
	     app reach an invoice parser on this Mac or the home network over plain
	     HTTP; every other server still needs HTTPS. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Background refresh fetches payments added on the website while the
	     app is closed. iOS decides when; opening the app always fetches. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.Khaja-Aflal.tripreceipts.web-inbox</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
</dict>
</plist>
